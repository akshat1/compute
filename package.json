{
  "name": "compute",
  "description": "A simple reactive programming library.",
  "keywords": [
    "reactive",
    "observable",
    "typescript"
  ],
  "homepage": "http://akshat1.github.io/compute/",
  "license": "MIT",
  "author": "akshat1",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "bugs": {
    "url": "https://github.com/akshat1/compute/issues",
    "email": "akshat.sh@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akshat1/compute"
  },
  "scripts": {
    "clean": "rm -rf docs coverage dist lcov.info",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"src/**/*.test.ts\"",
    "cov-html": "genhtml --output-directory=./coverage lcov.info",
    "doc": "typedoc",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.0"
  }
}
